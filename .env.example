# AutoDine — environment variable TEMPLATE
# No real values. Nothing secret. Copy to `.env.local` for local development
# (`.env.local` is gitignored and must never be committed).
#
# Supabase issues two key formats. Use whichever your project has; the app
# accepts both.
#
#   New projects (created after Nov 2025) — short keys:
#     NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#     SUPABASE_SECRET_KEY=sb_secret_...
#
#   Legacy projects — long JWT keys, removed by the end of 2026:
#     NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#     SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# If you are unsure which you have: Settings -> API Keys in the Supabase
# dashboard. A key starting with "eyJ" is legacy.

# --- Supabase (free tier) -------------------------------------------------
# Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe. Every query made with this is filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security -- can read and write every
# restaurant's data.
#
# NEVER prefix this with NEXT_PUBLIC_. Next.js inlines every NEXT_PUBLIC_*
# variable into the browser bundle, which would hand every visitor full access
# to the database. The app refuses to start if a secret key shows up there.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, for migrations and pg_dump backups. Server-only.
DATABASE_URL=

# --- Razorpay -- TEST MODE ONLY until you approve going live ---------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- App ------------------------------------------------------------------
# Public base URL, used for QR codes, receipts and webhook URLs.
NEXT_PUBLIC_SITE_URL=
