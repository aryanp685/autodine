# AutoDine — environment variable TEMPLATE
# No real values. Nothing secret. Copy to `.env.local` for local development
# (`.env.local` is gitignored and must never be committed).
#
# NOTHING HERE IS WIRED UP YET. The app currently runs entirely on mock data
# in lib/demo-data.ts. These are the names we will use when the backend lands.

# --- Supabase (free tier) -------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_, never ship to the browser.
# Bypasses Row Level Security -- only touch it in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for migrations and pg_dump backups. Server-only.
DATABASE_URL=

# --- Razorpay -- TEST MODE ONLY until you approve going live ---------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- App ------------------------------------------------------------------
# Public base URL, used for QR codes, receipts and webhook URLs.
NEXT_PUBLIC_SITE_URL=
