# Copy to .env.local for local development. Keep real values out of Git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional legacy aliases.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct database connection for local migration tooling.
DATABASE_URL=

# Server-only random value used for guest QR rate-limit fingerprints.
QR_VERIFICATION_SECRET=
