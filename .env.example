# AutoDine — environment variable TEMPLATE
# No real values. Nothing secret. Copy to `.env.local` for local development
# (`.env.local` is gitignored and must never be committed).
#
# Supabase issues two key formats. Use whichever your project has; the app
# accepts both.
#
#   New projects (created after Nov 2025) — short keys:
#     NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#     SUPABASE_SECRET_KEY=sb_secret_...
#
#   Legacy projects — long JWT keys, removed by the end of 2026:
#     NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#     SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# If you are unsure which you have: Settings -> API Keys in the Supabase
# dashboard. A key starting with "eyJ" is legacy.

# --- Supabase (free tier) -------------------------------------------------
# Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe. Every query made with this is filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security -- can read and write every
# restaurant's data.
#
# NEVER prefix this with NEXT_PUBLIC_. Next.js inlines every NEXT_PUBLIC_*
# variable into the browser bundle, which would hand every visitor full access
# to the database. The app refuses to start if a secret key shows up there.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, for migrations and pg_dump backups. Server-only.
DATABASE_URL=

# --- Razorpay (reserved/unused; no customer payment flow is shipped) --------
# Do not set these expecting online checkout or a webhook. No payment provider
# is approved or configured; guest orders remain pay-at-counter only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- App ------------------------------------------------------------------
# Local-only visual demo without a database. Use only with `next dev`; never
# set this on a deployment. The demo build exception for browser CI is separate.
# AUTODINE_DEMO_MODE=

# Public base URL, used for printed menu/table QR links and receipts.
# Set on the deployment to the production domain (e.g. https://autodine.example).
# SITE_URL is read first, then this one; with neither, the origin is taken from
# the incoming request. Not a secret -- it is printed on every table card.
NEXT_PUBLIC_SITE_URL=
# SITE_URL=

# --- Admin (server only) ---------------------------------------------------
# The credential for the trial-renewal admin tool (/api/admin/renew-trial).
# SERVER ONLY: never give it a NEXT_PUBLIC_ prefix -- that would hand the
# trial-renewal power to every visitor's browser. Generate with:
#     openssl rand -hex 32
# Must be at least 32 characters; shorter values fail closed and the admin
# tool refuses everyone until this is set properly. Rotating it is free:
# change the value here and on the deployment.
# ADMIN_SECRET=

# --- Menu import (optional) ------------------------------------------------
# Paste-a-menu import works with no key at all: lib/menu-import.ts reads the
# text by rules. These turn on the model path, which handles messier pastes.
# Both are server-only. With no key the screen says the rules are doing the
# work, and nothing is claimed that did not happen.
#
# MENU_AI_API_KEY=            # any OpenAI-compatible key
# OPENAI_API_KEY=             # used if MENU_AI_API_KEY is empty
# MENU_AI_BASE_URL=           # default https://api.openai.com/v1
# MENU_AI_MODEL=              # default gpt-4o-mini

# --- Reading a menu from a PHOTO (optional) --------------------------------
# Separate from the block above: that one reads TEXT and cannot see an image.
# This one sends a photo or a PDF to Gemini and gets back a draft with the
# uncertain fields marked. Server-only, like every key here -- never prefix
# any of these with NEXT_PUBLIC_, which would inline them into the browser
# bundle and hand the key to every visitor.
#
# With no key the Photo tab says photo reading is off and the dish editor
# works exactly as before. Manual editing never depends on this.
#
# GEMINI_API_KEY=
# GEMINI_MODEL=               # default gemini-2.5-flash
#
# The Storage bucket (restaurant-assets) needs no key of its own: it is
# created by migration 20261025001000 and written with the signed-in owner's
# session, so Row Level Security decides what may be uploaded.

# Set to live for the commercial deployment. Missing DB config then returns
# 503 on operational routes, never convincing sample orders. Preview/CI leave unset.
# AUTODINE_MODE=live

# Optional isolated staging safeguards (never set to the production ref).
# AUTODINE_EXPECTED_PROJECT_REF=
# AUTODINE_ISOLATED_STAGING=1

# Deployment isolation (docs/preview-isolation.md). Only the production
# deployment may use the production Supabase project: a build or server that is
# not production refuses to start with production's URL or keys. On Vercel the
# environment is read from VERCEL_ENV and nothing needs setting here. Hosting
# production somewhere else? Declare it there, and only there:
# AUTODINE_DEPLOY_ENV=production
#
# Further production project refs or Supabase hostnames to protect, comma
# separated (for example a custom domain in front of the production project):
# NEXT_PUBLIC_AUTODINE_PRODUCTION_SUPABASE_REFS=

# --- Transactional email (optional; Resend adapter) -------------------------
# Staff-invitation mail sends ONLY through this adapter, ONLY when both values
# are set, and the send outcome is reported honestly (delivered / failed /
# not connected). Signup confirmation and password recovery are Supabase
# Auth's mail and are configured in the Supabase dashboard, not here.
# Leave empty and invitation mail silently-but-honestly degrades to the
# copy-the-link flow — nothing is sent and nothing claims it was.
# RESEND_API_KEY=             # starts with re_ ...; never NEXT_PUBLIC_
# AUTODINE_EMAIL_FROM=        # e.g. AutoDine <hello@yourdomain>; domain must be verified in Resend

# --- Operational alerting (optional webhook) --------------------------------
# HTTPS POST endpoint that receives the fixed, tenant-free alert payload
# (incident opened/reopened/escalated/acknowledged/resolved, health probe
# failure). Works with a chat incoming webhook, an alertmanager, a ticket
# hook — anything that accepts HTTPS JSON POSTs. Unset = no push delivery;
# incidents still land in the structured log and in Settings → Operations.
# AUTODINE_ALERT_WEBHOOK=     # https:// only

# --- Scheduled incident escalation (optional) --------------------------------
# Vercel Cron calls /api/cron/escalate every 5 minutes (see vercel.json) to
# escalate incidents that stayed open and unacknowledged for 15+ minutes.
# Set the same value here and as the Vercel environment variable; the route
# fails closed (503) until it is set, and 401 for any other caller.
# AUTODINE_CRON_SECRET=       # openssl rand -hex 32

# --- Backup verification & DR objectives (scripts, not the app) --------------
# For scripts/backup/verify-backup-file.mjs and scripts/backup/check-dr-objectives.mjs:
# AUTODINE_BACKUP_PASSPHRASE= # the passphrase the backup was encrypted with
# DR_ALERT_WEBHOOK=           # https POST for "DR objective missed" alerts (falls back to BACKUP_ALERT_WEBHOOK)
# BACKUP_ALERT_WEBHOOK=       # https POST for backup failure alerts (same convention as scripts/backup/backup-logical.mjs)
# AUTODINE_D2_VERIFY_URL=     # read-only catalog connection for scripts/d2/verify-acl-posture.mjs (owner-run, post-release)
