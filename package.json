{
  "name": "autodine",
  "version": "0.1.0",
  "private": true,
  "description": "AutoDine — mobile-first QR ordering and restaurant-operations product preview.",
  "scripts": {
    "audit:definer": "node scripts/local-pg/with-embedded-postgres.mjs node scripts/local-pg/audit-definer-functions.mjs",
    "backup:run": "node scripts/backup/run-scheduled.mjs",
    "backup:verify-file": "node scripts/backup/verify-backup-file.mjs",
    "build": "next build",
    "d2:verify": "node scripts/d2/verify-acl-posture.mjs",
    "db:reconcile": "node scripts/reconcile/reconcile-migrations.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dr:objectives": "node scripts/backup/check-dr-objectives.mjs",
    "e2e": "playwright test",
    "e2e:demo": "GITHUB_ACTIONS=true CI=true AUTODINE_TEST_DEMO_BUILD=true VERCEL_ENV=test npm run build && GITHUB_ACTIONS=true CI=true AUTODINE_TEST_DEMO_BUILD=true VERCEL_ENV=test bash scripts/e2e/run-with-bundled-chromium.sh npm run e2e -- --project=desktop --project=phone --project=guest --project=staff --project=brand --project=responsive --output=test-results/supabase-e2e/demo-output --reporter=list,html,json",
    "e2e:install": "playwright install chromium",
    "e2e:local": "GITHUB_ACTIONS=true CI=true AUTODINE_TEST_DEMO_BUILD=true VERCEL_ENV=test npm run build && GITHUB_ACTIONS=true CI=true AUTODINE_TEST_DEMO_BUILD=true VERCEL_ENV=test bash scripts/e2e/run-with-bundled-chromium.sh npm run e2e",
    "email:test-send": "tsx scripts/email/send-test-email.ts",
    "env:check": "node scripts/check-env.mjs",
    "hosted:preflight": "node scripts/hosted-verification/preflight.mjs",
    "isolation:verify": "node scripts/verify-preview-isolation.mjs",
    "lint": "eslint .",
    "migrations:verify": "node scripts/verify-migration-chain.mjs",
    "pitr:check": "node scripts/verify-pitr-checklist.mjs",
    "seed:sql": "tsx scripts/emit-seed.ts",
    "sql:check": "node scripts/check-sql.mjs",
    "staging:seed-demo": "tsx scripts/staging/seed-demo.ts",
    "staging:verify-env": "node scripts/staging/verify-acceptance-env.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "vitest run",
    "test:backup": "node scripts/backup/selftest.mjs",
    "test:client-independence": "node scripts/verify-client-independence.mjs",
    "test:d2": "node --test scripts/d2/verify-acl-posture.test.mjs",
    "test:db": "node scripts/verify-database.mjs",
    "test:db:embedded": "node scripts/local-pg/with-embedded-postgres.mjs node scripts/verify-database.mjs",
    "test:db:integration": "node scripts/local-pg/run-integration-tests.mjs",
    "test:db:local": "node scripts/local-pg/run-embedded-tests.mjs",
    "test:db:logical-restore": "node scripts/verify-logical-restore-embedded.mjs",
    "test:db:report-sales-upgrade": "node scripts/local-pg/with-embedded-postgres.mjs node scripts/local-pg/verify-report-sales-upgrade.mjs",
    "test:dr": "node --test scripts/backup/verify-backup-file.test.mjs scripts/backup/check-dr-objectives.test.mjs scripts/backup/run-scheduled.test.mjs scripts/backup/b2-upload.test.mjs scripts/backup/prune-b2.test.mjs scripts/backup/verify-restored-db.test.mjs",
    "test:e2e:throttle": "bash scripts/e2e/run-throttle.sh",
    "test:hosted:preflight": "node --test scripts/hosted-verification/preflight.test.mjs",
    "test:recovery:cold": "node scripts/verify-cold-recovery.mjs",
    "test:staging:guards": "node --test scripts/staging/verify-acceptance-env.test.mjs scripts/phase3/build-staging-rehearsal.test.mjs scripts/phase3/read-only-probe.test.mjs",
    "test:staging:seed-demo-db": "node scripts/local-pg/with-embedded-postgres.mjs node --test scripts/staging/seed-demo.db.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:local-gates": "node scripts/verify-local-gates.mjs",
    "verify:release": "node scripts/release/verify-release-readiness.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "msedge-tts": "^2.1.1",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.14",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^10.13.0",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "pgsql-ast-parser": "^12.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "license": "UNLICENSED"
}
