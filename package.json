{
  "name": "autodine",
  "version": "0.1.0",
  "private": true,
  "description": "AutoDine — mobile-first QR ordering and restaurant-operations product preview.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/check-design-system.mjs",
    "sql:check": "node scripts/check-sql.mjs",
    "seed:sql": "tsx scripts/emit-seed.ts",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "next": "^16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.13.0",
    "pgsql-ast-parser": "^12.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
